# PostgreSQL connection (required)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Public canonical URL used for sitemap / Open Graph (can also be set in Admin → Settings → SEO)
NEXT_PUBLIC_SITE_URL=

# Optional: require a one-time token on the /admin/setup screen when creating the ceo@mrhome.com account.
# Strongly recommended in production so only you can complete the initial secure setup.
ADMIN_SETUP_TOKEN=

# Cloudflare R2 object storage for admin uploads (media library, galleries, brochures).
# Without these the app falls back to in-band server uploads, which Vercel limits to
# ~4 MB — set all four for any environment where admins upload real files.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional explicit S3 endpoint (defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com).
R2_ENDPOINT=
# Optional public delivery base (r2.dev domain or custom domain). Leave empty to proxy media
# through /api/media/[id]. The bucket must also allow browser PUTs from the site origin (CORS).
R2_PUBLIC_URL=
